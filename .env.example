# Template only: this app does not auto-load .env files today.
# Either export these in PowerShell before running locally, or configure them
# in your hosting provider's secrets/env-var panel.
# Never commit real credentials or Firebase service-account JSON.

# Use Firestore for game profiles/world persistence.
STORE=firebase

# Local development option: point at a downloaded Firebase Admin service account.
# In production, prefer your host's secret manager or FIREBASE_SERVICE_ACCOUNT.
GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\firebase-service-account.json

# Production option: paste the full service-account JSON into a secret/env var.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Required in production by server/startup-config.js.
NODE_ENV=production
PUBLIC_URL=https://your-game-domain.example
TRUST_PROXY=1
DATA_DIR=C:\absolute\path\to\blockcraft-data
CLIENT_ORIGIN=https://your-vercel-client.vercel.app
# Optional: enables POST /auth/admin/reset-player for owner-only profile resets.
# Use a long random secret and send it as the x-admin-reset-token header.
ADMIN_RESET_TOKEN=

# MySQL auth bridge for existing teacher/student accounts.
# Do not use the credentials pasted in chat; rotate them first.
AUTH_BACKEND=mysql
MYSQL_HOST=liveweave.net
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=change_me

# In-game homework/question database.
# This powers Recall/P questions, Question Hall homework progress, and the
# tavern Scholar Table / Knowledge Challenge. These override MYSQL_* for
# learning content only, so auth can remain separate if needed.
GAME_QUESTION_MYSQL_HOST=liveweave.net
GAME_QUESTION_MYSQL_PORT=3306
GAME_QUESTION_MYSQL_DATABASE=your_liveweave_question_database
GAME_QUESTION_MYSQL_USER=your_liveweave_question_user
GAME_QUESTION_MYSQL_PASSWORD=change_me

# Teacher curriculum request email bridge.
# The PHP bridge runs on SiteGround and uses native PHP mail().
CURRICULUM_MAIL_BRIDGE_URL=https://compscigo.com/teacher/blockcraft_curriculum_mail.php
# Must match BLOCKCRAFT_CURRICULUM_MAIL_SECRET in deploy/siteground/blockcraft_curriculum_mail_config.php.
# The Node server also accepts BLOCKCRAFT_CURRICULUM_MAIL_SECRET directly.
CURRICULUM_MAIL_BRIDGE_SECRET=change_me_to_match_siteground_config
CURRICULUM_NOTIFY_TO=asherlevin85@gmail.com
